type LoginResponse {
    accessToken: String!
    refreshToken: String!
    roleName: RoleName!
}

type RegisterResponse {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    phoneNumber: String!
    roleName: RoleName!
    accessToken: String!
    refreshToken: String!
}

type RefreshResponse {
    accessToken: String!
}